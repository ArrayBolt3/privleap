[Unit]
Description=privleap - Limited Privilege Escalation Framework
StartLimitIntervalSec=10
StartLimitBurst=3
DefaultDependencies=no
Requires=sysinit.target
After=sysinit.target
Conflicts=shutdown.target
Before=basic.target
Before=shutdown.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/privleapd
ExecReload=/usr/bin/leapctl --reload
## privleapd pings at a quarter of this and stops pinging once its main loop
## has been stuck for half of it, so a genuinely wedged daemon is still caught
## well inside the deadline. The deadline itself is generous because a loaded
## or memory-pressured host can deschedule the process for several seconds at
## a time, which is not a fault worth restarting over.
WatchdogSec=30s
Restart=always

[Install]
WantedBy=multi-user.target
