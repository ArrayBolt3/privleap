set -o errexit
set -o nounset
set -o errtrace
set -o pipefail
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

privleap_project_dir="$(dirname "$(readlink -f "${0}")")"
target_distribution="trixie"
autopkgtest_tarball_path="${HOME}/.cache/sbuild/${target_distribution}-amd64.tar.zst"
test_artifacts_dir="${privleap_project_dir}/test_artifacts"
test_log_file="${privleap_project_dir}/privleap-test-log.txt"
tests_control_file="${privleap_project_dir}/debian/tests/control"
tests_control_template_file="${tests_control_file}.in"

create_autopkgtest_tarball() {
  mkdir -p ~/.cache/sbuild
  ## TODO: Can we use dracut instead of initramfs-tools? (We have to install
  ## initramfs-tools here right now to make the autopkgtest environment happy
  ## but maybe dracut will work instead.)
  sudo mmdebstrap \
    --include=ca-certificates,passwd,adduser,initramfs-tools,sudo \
    --skip=output/dev \
    --variant=debootstrap \
    "${target_distribution}" \
    "${autopkgtest_tarball_path}" \
    --customize-hook='chroot "$1" passwd --delete root' \
    --customize-hook='chroot "$1" useradd --home-dir /home/user --create-home user' \
    --customize-hook='chroot "$1" passwd --delete user' \
    --customize-hook='cp /etc/hosts "$1/etc/hosts"' \
    --customize-hook=/usr/share/autopkgtest/setup-commands/setup-testbed \
    https://deb.debian.org/debian
}

offer_package_install() {
  local pkg_name install_yn
  pkg_name="$1"
  1>&2 echo "${pkg_name} is not installed, but is needed to run the test suite."
  1>&2 echo -n 'Would you like to install it now? [y/N] '
  read -r install_yn
  if [ "${install_yn,,}" = 'y' ]; then
    sudo apt-get install "${pkg_name}"
  else
    1>&2 echo 'Test run aborted.'
    exit 1
  fi
}

clean_test_artifacts() {
  genmkfile deb-cleanup
  safe-rm --recursive --force -- "${test_artifacts_dir}"
  safe-rm --force -- "${test_log_file}"
  safe-rm --force -- "${tests_control_file}"
}

print_usage() {
  local help_info
  help_info='run_autopkgtest: Runs regression tests for privleap using autopkgtest
Usage:
  run_autopkgtest [--reset-tarball|--clean] [<mode>]
Options:
  --reset-tarball: Deletes and recreates the tarball used by unshare
    for running the tests.
  --clean: Delete test artifacts, but do not run the test.
  <mode>: One of "all", "leapctl", "leaprun", or "privleapd". Specifies which
    component of privleap to test. Mandatory unless --clean is passed.'
  printf '%s\n' "${help_info}" 1>&2
}

run_autopkgtest() {
  local arg stop_after_clean
  stop_after_clean='false'
  delete_old_tarball='false'
  test_component=''
  if [ "${1:-}" = '--help' ] || [ "${1:-}" = '-h' ] || [ "${1:-}" = '-?' ]; then
    print_usage
    exit 0
  fi

  if [ "$(id -u)" = '0' ]; then
    1>&2 echo 'Do not run this script as root!'
    exit 1
  fi

  if [ "${1:-}" = '--clean' ]; then
    stop_after_clean='true'
    shift
  elif [ "${1:-}" = '--reset-tarball' ]; then
    delete_old_tarball='true'
    shift
  fi
  if [ "${stop_after_clean}" = 'false' ]; then
    if [ -z "${1:-}" ]; then
      printf '%s\n' "ERROR: No test component provided! Try 'run_autopkgtest --help' for usage info."
      exit 1
    fi
    if ! [[ "${1:-}" =~ ^(all|leapctl|leaprun|privleapd)$ ]]; then
      printf '%s\n' "ERROR: Unrecognized test component '${1:-}' provided!"
      exit 1
    fi
    test_component="${1:-}"
  fi

  if [ "${delete_old_tarball}" = 'true' ]; then
    safe-rm -f -- "${autopkgtest_tarball_path}"
  fi

  ## Dependency checks
  if ! [ -x '/usr/bin/unshare' ]; then
    1>&2 echo 'unshare is not executable or does not exist!'
    exit 1
  fi
  if ! [ -f '/usr/bin/safe-rm' ]; then
    offer_package_install 'safe-rm'
  fi
  if ! [ -f '/usr/bin/autopkgtest' ]; then
    offer_package_install 'autopkgtest'
  fi
  if ! [ -f '/usr/bin/mmdebstrap' ]; then
    offer_package_install 'mmdebstrap'
  fi
  if ! [ -f '/usr/bin/dh' ]; then
    offer_package_install 'debhelper'
  fi
  if ! [ -f '/usr/share/keyrings/debian-archive-trixie-stable.gpg' ]; then
    offer_package_install 'debian-archive-keyring'
  fi
  if ! [ -f '/usr/bin/newuidmap' ] || ! [ -f '/usr/bin/newgidmap' ]; then
    offer_package_install 'uidmap'
  fi
  if [ "$(basename "${privleap_project_dir}")" != 'privleap' ]; then
    1>&2 echo 'The run_autopkgtest script does not appear to be in the root of the privleap source tree!'
    exit 1
  fi
  if [ "$(stat -c "%u|%a" /usr/bin/newuidmap)" != '0|4755' ]; then
    if [ -f /run/qubes/persistent-rw-only ] \
      || [ -f /run/qubes/persistent-none ]; then
      ## Change is ephemeral in Qubes AppVMs, therefore safe enough.
      sudo chown root:root /usr/bin/newuidmap
      sudo chmod 4755 /usr/bin/newuidmap
    else
      1>&2 echo 'autopkgtest requires /usr/bin/newuidmap to be SUID-root!'
      exit 1
    fi
  fi
  if [ "$(stat -c "%u|%a" /usr/bin/newgidmap)" != '0|4755' ]; then
    if [ -f /run/qubes/persistent-rw-only ] \
      || [ -f /run/qubes/persistent-none ]; then
      ## Change is ephemeral in Qubes AppVMs, therefore safe enough.
      sudo chown root:root /usr/bin/newgidmap
      sudo chmod 4755 /usr/bin/newgidmap
    else
      1>&2 echo 'autopkgtest requires /usr/bin/newgidmap to be SUID-root!'
      exit 1
    fi
  fi
  if [ "$(pwd)" != "${privleap_project_dir}" ]; then
    cd "${privleap_project_dir}" >/dev/null || {
      1>&2 echo 'Cannot change to privleap source tree directory!'
      exit 1
    }
  fi

  clean_test_artifacts
  if [ "${stop_after_clean}" = 'true' ]; then
    exit 0
  fi

  if ! [ -f "${autopkgtest_tarball_path}" ]; then
    create_autopkgtest_tarball
  fi

  sed \
    "s/@TEST_MODE@/privleap-test-${test_component}/" \
    "${tests_control_template_file}" \
    > "${tests_control_file}"

  dpkg-buildpackage -i -us -uc -b || {
    1>&2 echo 'Cannot build privleap deb package!'
    exit 1
  }
  cd ..
  autopkgtest -l "${test_log_file}" --output-dir="${test_artifacts_dir}" \
    --apt-upgrade -B privleap*.deb "${privleap_project_dir}" -- unshare
  echo "Test complete. Results are stored in ${privleap_project_dir}/privleap-test-log.txt."
}

run_autopkgtest "$@"
